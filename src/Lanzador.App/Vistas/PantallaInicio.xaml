<UserControl x:Class="Lanzador.App.Vistas.PantallaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="PanelHorizontal">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- GameTile de la fila (tile-shelf 264): con foco crece a 1.08, brilla y muestra su nombre -->
        <DataTemplate x:Key="PlantillaCaratula">
            <StackPanel Width="264" Margin="0,0,24,0" Cursor="Hand" MouseLeftButtonDown="AlPulsarCaratula">
                <Grid x:Name="Arte" Width="264" Height="264" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="EscalaArte" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <!-- shadow-raise y shadow-focus, detrás (así el arte no se difumina) -->
                    <Border x:Name="Sombra" CornerRadius="{StaticResource radius-lg}" Background="{StaticResource bg-000}"
                            Effect="{StaticResource shadow-raise}" Visibility="Collapsed"/>
                    <Border x:Name="Brillo" CornerRadius="{StaticResource radius-lg}" Background="{StaticResource focus}"
                            Effect="{StaticResource shadow-focus}" Visibility="Collapsed" Opacity="0"/>
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,264,264" RadiusX="16" RadiusY="16"/>
                        </Grid.Clip>
                        <Border Background="{StaticResource surface-300}">
                            <TextBlock x:Name="Iniciales" Text="{Binding Juego.Iniciales}" FontFamily="{StaticResource font-display}" FontWeight="SemiBold"
                                       FontSize="44" Foreground="{StaticResource ink-300}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Juego.Icono}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- Destello que cruza la carátula al recibir el foco -->
                        <Rectangle x:Name="Destello" Width="200" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False"
                                   Visibility="{DynamicResource visibilidad-destello}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="PosicionDestello" X="-220"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <Border x:Name="Marco" CornerRadius="{StaticResource radius-lg}" BorderBrush="{StaticResource line-100}" BorderThickness="1"/>
                </Grid>
                <TextBlock x:Name="Nombre" Text="{Binding Juego.Nombre}" FontFamily="{StaticResource font-text}" FontWeight="Medium" FontSize="17"
                           LineHeight="22" Foreground="{StaticResource ink-100}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="PosicionNombre" Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Juego.SinIcono}" Value="True">
                    <Setter TargetName="Iniciales" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                    <Setter TargetName="Sombra" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Brillo" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource focus}"/>
                    <Setter TargetName="Marco" Property="BorderThickness" Value="3"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleX" To="1.08"
                                                 Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleY" To="1.08"
                                                 Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimation Storyboard.TargetName="Brillo" Storyboard.TargetProperty="Opacity" To="1"
                                                 Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimation Storyboard.TargetName="Nombre" Storyboard.TargetProperty="Opacity" To="1"
                                                 Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimation Storyboard.TargetName="PosicionNombre" Storyboard.TargetProperty="Y" To="8"
                                                 Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Destello" Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.62" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="PosicionDestello" Storyboard.TargetProperty="X" From="-220" To="300"
                                                 BeginTime="0:0:0.06" Duration="0:0:0.56" EasingFunction="{StaticResource ease-in-out}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleX" To="1"
                                                 Duration="{StaticResource dur-fast}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleY" To="1"
                                                 Duration="{StaticResource dur-fast}" EasingFunction="{StaticResource ease-out}"/>
                                <DoubleAnimation Storyboard.TargetName="Brillo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                                <DoubleAnimation Storyboard.TargetName="Nombre" Storyboard.TargetProperty="Opacity" To="0"
                                                 Duration="{StaticResource dur-fast}"/>
                                <DoubleAnimation Storyboard.TargetName="PosicionNombre" Storyboard.TargetProperty="Y" To="0"
                                                 Duration="{StaticResource dur-fast}"/>
                                <DoubleAnimation Storyboard.TargetName="Destello" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- HeroHeader: el juego con foco -->
        <StackPanel x:Name="Heroe" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,168,0,0" Width="1180">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="PosicionHeroe"/>
            </StackPanel.RenderTransform>
            <TextBlock x:Name="TextoDetalle" Style="{StaticResource label}"/>
            <TextBlock x:Name="TextoNombre" Style="{StaticResource display-xl}" Margin="0,14,0,0"/>
            <WrapPanel x:Name="PanelChips" Margin="0,18,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <!-- ActionButton principal: siempre con el anillo de foco, es lo que hace A -->
                <Grid x:Name="BotonJugar" Cursor="Hand" MouseLeftButtonUp="AlPulsarJugar">
                    <Border CornerRadius="{StaticResource radius-md}" Background="{StaticResource focus}" Effect="{StaticResource shadow-focus}" Opacity="0.85"/>
                    <Border CornerRadius="{StaticResource radius-md}" Background="{StaticResource accent-500}" BorderBrush="{StaticResource focus}"
                            BorderThickness="3" Padding="13,11,27,11">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="A" ContentTemplate="{StaticResource PlantillaGlifo}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TextoJugar" Text="Jugar" FontFamily="{StaticResource font-text}" FontWeight="SemiBold" FontSize="24"
                                       LineHeight="32" Foreground="{StaticResource on-accent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                    <ContentPresenter Content="X" ContentTemplate="{StaticResource PlantillaGlifo}"/>
                    <TextBlock Text="Trucos" FontFamily="{StaticResource font-text}" FontSize="20" Foreground="{StaticResource ink-100}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                    <ContentPresenter Content="Y" ContentTemplate="{StaticResource PlantillaGlifo}"/>
                    <TextBlock Text="Más opciones" FontFamily="{StaticResource font-text}" FontSize="20" Foreground="{StaticResource ink-100}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Shelves: filas de carátulas; la fila con foco queda arriba de esta zona -->
        <Canvas x:Name="ZonaFilas" Margin="0,560,0,0" ClipToBounds="True">
            <StackPanel x:Name="ListaFilas" Canvas.Left="0" Canvas.Top="30">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="PosicionFilas"/>
                </StackPanel.RenderTransform>
            </StackPanel>
        </Canvas>

        <TextBlock x:Name="TextoMensaje" Style="{StaticResource body-l}" Foreground="{StaticResource ink-200}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900" Visibility="Collapsed"/>
    </Grid>
</UserControl>
