<UserControl x:Class="Lanzador.App.Vistas.PantallaBiblioteca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,104,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros (Y) y orden -->
        <DockPanel Margin="64,8,64,0">
            <TextBlock Text="Orden: A–Z" Style="{StaticResource body}" FontSize="18" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            <StackPanel x:Name="ListaFiltros" Orientation="Horizontal"/>
        </DockPanel>

        <!-- Cuadrícula (tile-grid 200): se desliza para que la fila con foco quede a la vista -->
        <Canvas x:Name="Zona" Grid.Row="1" ClipToBounds="True" Margin="0,8,0,0" SizeChanged="AlCambiarTamanoZona">
            <ItemsControl x:Name="Cuadricula" Focusable="False" Canvas.Left="64" Canvas.Top="28">
                <ItemsControl.RenderTransform>
                    <TranslateTransform x:Name="PosicionCuadricula"/>
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="200" Margin="0,0,24,36" Cursor="Hand" MouseLeftButtonDown="AlPulsarJuego">
                            <Grid x:Name="Arte" Width="200" Height="200" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="EscalaArte" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Border x:Name="Sombra" CornerRadius="{StaticResource radius-lg}" Background="{StaticResource bg-000}"
                                        Effect="{StaticResource shadow-raise}" Visibility="Collapsed"/>
                                <Border x:Name="Brillo" CornerRadius="{StaticResource radius-lg}" Background="{StaticResource focus}"
                                        Effect="{StaticResource shadow-focus}" Visibility="Collapsed"/>
                                <Grid>
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,200,200" RadiusX="16" RadiusY="16"/>
                                    </Grid.Clip>
                                    <Border Background="{StaticResource surface-300}">
                                        <TextBlock x:Name="Iniciales" Text="{Binding Iniciales}" FontFamily="{StaticResource font-display}" FontWeight="SemiBold"
                                                   FontSize="44" Foreground="{StaticResource ink-300}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Border>
                                    <Border>
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Icono}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <Border x:Name="Marco" CornerRadius="{StaticResource radius-lg}" BorderBrush="{StaticResource line-100}" BorderThickness="1"/>
                            </Grid>
                            <TextBlock x:Name="Nombre" Text="{Binding Nombre}" FontFamily="{StaticResource font-text}" FontSize="17" LineHeight="22"
                                       Foreground="{StaticResource ink-200}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="PosicionNombre"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding SinIcono}" Value="True">
                                <Setter TargetName="Iniciales" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                <Setter TargetName="Sombra" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Brillo" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource focus}"/>
                                <Setter TargetName="Marco" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="Nombre" Property="Foreground" Value="{StaticResource ink-100}"/>
                                <Setter TargetName="Nombre" Property="FontWeight" Value="Medium"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleX" To="1.08"
                                                             Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                            <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleY" To="1.08"
                                                             Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                            <DoubleAnimation Storyboard.TargetName="PosicionNombre" Storyboard.TargetProperty="Y" To="10"
                                                             Duration="{StaticResource dur-focus}" EasingFunction="{StaticResource ease-out}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleX" To="1"
                                                             Duration="{StaticResource dur-fast}" EasingFunction="{StaticResource ease-out}"/>
                                            <DoubleAnimation Storyboard.TargetName="EscalaArte" Storyboard.TargetProperty="ScaleY" To="1"
                                                             Duration="{StaticResource dur-fast}" EasingFunction="{StaticResource ease-out}"/>
                                            <DoubleAnimation Storyboard.TargetName="PosicionNombre" Storyboard.TargetProperty="Y" To="0"
                                                             Duration="{StaticResource dur-fast}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <TextBlock x:Name="TextoMensaje" Grid.Row="1" Style="{StaticResource body-l}" Foreground="{StaticResource ink-200}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="900" Visibility="Collapsed"/>
    </Grid>
</UserControl>
