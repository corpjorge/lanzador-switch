<UserControl x:Class="Lanzador.App.Vistas.PantallaJuego"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tema="clr-namespace:Lanzador.App.Tema">
    <UserControl.Resources>
        <!-- SelectorRow: clave a la izquierda, valor y una flecha si se puede abrir -->
        <Style x:Key="Fila" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource radius-md}"/>
            <Setter Property="Padding" Value="21,11"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="{StaticResource surface-glass-strong}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="ClaveFila" TargetType="TextBlock" BasedOn="{StaticResource body-l}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ValorFila" TargetType="TextBlock" BasedOn="{StaticResource body-l}">
            <Setter Property="Foreground" Value="{StaticResource ink-200}"/>
            <Setter Property="Margin" Value="16,0,16,0"/>
        </Style>
        <Style x:Key="FlechaFila" TargetType="TextBlock">
            <Setter Property="Text" Value="›"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource ink-200}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Más oscuro a la izquierda para leer sobre el arte del juego -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F00C1118" Offset="0"/>
                    <GradientStop Color="#C00C1118" Offset="0.45"/>
                    <GradientStop Color="#400C1118" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Migas: de dónde se vino -->
        <StackPanel Orientation="Horizontal" Height="104" VerticalAlignment="Top" Margin="64,0,64,0">
            <TextBlock x:Name="TextoOrigen" Style="{StaticResource body}" VerticalAlignment="Center"/>
            <TextBlock Text="›" Style="{StaticResource body}" VerticalAlignment="Center" Margin="16,0,16,2"/>
            <TextBlock x:Name="TextoMiga" Style="{StaticResource body}" Foreground="{StaticResource ink-100}" VerticalAlignment="Center" MaxWidth="1400"/>
        </StackPanel>

        <Grid Margin="64,150,64,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cover (tile-hero 360) -->
            <StackPanel>
                <Grid Width="360" Height="360">
                    <Border CornerRadius="{StaticResource radius-lg}" Background="{StaticResource bg-000}" Effect="{StaticResource shadow-raise}"/>
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,360,360" RadiusX="16" RadiusY="16"/>
                        </Grid.Clip>
                        <Border Background="{StaticResource surface-300}">
                            <TextBlock x:Name="TextoIniciales" FontFamily="{StaticResource font-display}" FontWeight="Bold" FontSize="80"
                                       Foreground="{StaticResource ink-300}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="ImagenCaratula" Stretch="UniformToFill"/>
                    </Grid>
                    <Border CornerRadius="{StaticResource radius-lg}" BorderBrush="{StaticResource line-100}" BorderThickness="1"/>
                </Grid>
                <TextBlock Text="IDENTIFICADOR" Style="{StaticResource label}" Margin="0,20,0,6"/>
                <TextBlock x:Name="TextoId" Style="{StaticResource mono}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="64,0,0,0">
                <TextBlock x:Name="TextoNombre" Style="{StaticResource display-xl}" MaxWidth="1100" HorizontalAlignment="Left"/>
                <WrapPanel x:Name="PanelChips" Margin="0,22,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <!-- ActionButton principal -->
                    <Grid x:Name="BotonJugar" Cursor="Hand" MouseLeftButtonUp="AlPulsarJugar">
                        <Border x:Name="BrilloJugar" CornerRadius="{StaticResource radius-md}" Background="{StaticResource focus}"
                                Effect="{StaticResource shadow-focus}" Opacity="0.85"/>
                        <Border x:Name="CajaJugar" CornerRadius="{StaticResource radius-md}" Background="{StaticResource accent-500}"
                                BorderBrush="{StaticResource focus}" BorderThickness="3" Padding="15,13,29,13">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="A" ContentTemplate="{StaticResource PlantillaGlifo}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TextoJugar" Text="Jugar" FontFamily="{StaticResource font-text}" FontWeight="SemiBold" FontSize="26"
                                           LineHeight="34" Foreground="{StaticResource on-accent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Selector de emulador (LB / RB) -->
                    <Border Margin="20,0,0,0" Padding="8" Background="{StaticResource surface-glass}" tema:Forma.Pastilla="True" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="LB" ContentTemplate="{StaticResource PlantillaGlifo}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="ListaEmuladores" Orientation="Horizontal" Margin="10,0,10,0"/>
                            <ContentPresenter Content="RB" ContentTemplate="{StaticResource PlantillaGlifo}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cómo volver al lanzador durante el juego -->
                <TextBlock x:Name="TextoVolver" Style="{StaticResource caption}" Margin="0,16,0,0" TextWrapping="Wrap" MaxWidth="1080" HorizontalAlignment="Left"/>

                <StackPanel x:Name="Filas" Margin="0,22,0,0" MaxWidth="1080" HorizontalAlignment="Left" Width="1080">
                    <Border x:Name="FilaTrucos" Style="{StaticResource Fila}" Cursor="Hand" MouseLeftButtonUp="AlPulsarFila">
                        <DockPanel>
                            <TextBlock Text="Trucos" Style="{StaticResource ClaveFila}" Width="260"/>
                            <TextBlock Style="{StaticResource FlechaFila}" DockPanel.Dock="Right"/>
                            <TextBlock x:Name="TextoTrucos" Style="{StaticResource ValorFila}"/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="FilaCalificacion" Style="{StaticResource Fila}" Cursor="Hand" MouseLeftButtonUp="AlPulsarFila">
                        <DockPanel>
                            <TextBlock Text="Tu calificación" Style="{StaticResource ClaveFila}" Width="260"/>
                            <TextBlock Style="{StaticResource FlechaFila}" DockPanel.Dock="Right"/>
                            <TextBlock x:Name="TextoCalificacion" Style="{StaticResource ValorFila}"/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="FilaVersion" Style="{StaticResource Fila}">
                        <DockPanel>
                            <TextBlock Text="Versión" Style="{StaticResource ClaveFila}" Width="260"/>
                            <TextBlock x:Name="TextoBuildId" Style="{StaticResource mono}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TextoVersion" Style="{StaticResource ValorFila}"/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="FilaArchivo" Style="{StaticResource Fila}" Cursor="Hand" MouseLeftButtonUp="AlPulsarFila">
                        <DockPanel>
                            <TextBlock Text="Archivo" Style="{StaticResource ClaveFila}" Width="260"/>
                            <TextBlock Style="{StaticResource FlechaFila}" DockPanel.Dock="Right"/>
                            <TextBlock x:Name="TextoArchivo" Style="{StaticResource ValorFila}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
