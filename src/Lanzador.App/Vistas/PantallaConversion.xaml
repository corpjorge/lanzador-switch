<UserControl x:Class="Lanzador.App.Vistas.PantallaConversion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tema="clr-namespace:Lanzador.App.Tema">
    <UserControl.Resources>
        <!-- Barra de progreso: 10 px, radius-sm, surface-300 con relleno accent-500 -->
        <Style x:Key="Barra" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="{StaticResource radius-sm}" Background="{StaticResource surface-300}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="{StaticResource radius-sm}" Background="{StaticResource accent-500}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="64,40,64,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="JUEGOS COMPRIMIDOS" Style="{StaticResource label}"/>
            <TextBlock Text="Convertir NSZ a NSP" Style="{StaticResource display-l}" Margin="0,18,0,0"/>
            <TextBlock Style="{StaticResource caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Descomprime cada .nsz a un .nsp en su misma carpeta y comprueba el sha256 de todo su contenido. El .nsz no se toca: solo cuando el .nsp queda verificado puedes enviarlo a la papelera."/>
            <Border Style="{StaticResource Chip}" Margin="0,12,0,0" HorizontalAlignment="Left" Background="{StaticResource accent-soft}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource focus}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="TextoResumen" Style="{StaticResource chip}" TextTrimming="CharacterEllipsis" MaxWidth="1700"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock x:Name="TextoVacio" Grid.Row="1" Style="{StaticResource body-l}" Foreground="{StaticResource ink-200}" Margin="0,40,0,0"
                   TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"/>

        <ScrollViewer x:Name="Desplazador" Grid.Row="1" Margin="-24,0,-24,0" Padding="24,18,24,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl x:Name="ListaArchivos" Focusable="False" Margin="0,0,0,40">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Fila" CornerRadius="{StaticResource radius-md}" Padding="21,12" Margin="0,0,0,10" Background="{StaticResource surface-100}"
                                BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonUp="AlPulsarArchivo">
                            <StackPanel>
                                <DockPanel>
                                    <!-- Qué hace A en la fila elegida -->
                                    <Border x:Name="Accion" DockPanel.Dock="Right" Padding="8,6,18,6" Margin="16,0,0,0" Background="{StaticResource accent-500}"
                                            tema:Forma.Pastilla="True" Visibility="Collapsed" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="A" ContentTemplate="{StaticResource PlantillaGlifo}"/>
                                            <TextBlock Text="{Binding TextoAccion}" FontFamily="{StaticResource font-text}" FontWeight="SemiBold" FontSize="20"
                                                       Foreground="{StaticResource on-accent}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ChipEstado" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="PuntoEstado" Width="10" Height="10" Fill="{StaticResource ink-300}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                            <TextBlock Text="{Binding TextoEstado}" Style="{StaticResource chip}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Nombre}" Style="{StaticResource body-l}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding TextoTamano}" Style="{StaticResource body}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TextoDetalle" Text="{Binding Detalle}" Style="{StaticResource caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                                <StackPanel x:Name="PanelProgreso" Margin="0,10,0,2" Visibility="Collapsed">
                                    <ProgressBar Style="{StaticResource Barra}" Value="{Binding Progreso, Mode=OneWay}"/>
                                    <TextBlock Text="{Binding TextoProgreso}" Style="{StaticResource caption}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Nivel}" Value="ok">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource ok-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource ok-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Nivel}" Value="nuevo">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource accent-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource focus}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Nivel}" Value="aviso">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource warn-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource warn-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Nivel}" Value="error">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource danger-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource danger-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Ocupado}" Value="True">
                                <Setter TargetName="PanelProgreso" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextoDetalle" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultadoError}" Value="True">
                                <Setter TargetName="TextoDetalle" Property="Foreground" Value="{StaticResource danger-500}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Seleccionado}" Value="True"/>
                                    <Condition Binding="{Binding TieneAccion}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Accion" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{StaticResource surface-200}"/>
                                <Setter TargetName="Fila" Property="BorderBrush" Value="{StaticResource focus}"/>
                                <Setter TargetName="Fila" Property="Effect" Value="{StaticResource shadow-focus}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
