<UserControl x:Class="Lanzador.App.Vistas.PantallaConfiguracion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="64,40,64,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CONFIGURACIÓN" Style="{StaticResource label}"/>
            <TextBlock Text="Ajustes" Style="{StaticResource display-l}" Margin="0,18,0,0"/>
            <TextBlock Text="Con el mando: ↑ ↓ para moverte, A para pulsar o marcar, ← → para cambiar opciones, ☰ para guardar y B para salir sin guardar."
                       Style="{StaticResource caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer x:Name="Desplazador" Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="Formulario" MaxWidth="1100" HorizontalAlignment="Left" Margin="16,0,24,30">
                <TextBlock Text="Emuladores" Style="{StaticResource title}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="ListaEmuladores" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource surface-100}" CornerRadius="{StaticResource radius-lg}" Padding="24,18" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Content="Activo" IsChecked="{Binding Activo}" Style="{StaticResource Casilla}"/>
                                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource title}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="Ejecutable" Style="{StaticResource caption}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Examinar…" Style="{StaticResource BotonPlano}" Margin="10,4,0,10" Click="AlExaminarExe"/>
                                        <TextBox Text="{Binding RutaExe, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}"/>
                                    </DockPanel>
                                    <TextBlock Text="Argumentos para abrir un juego ({juego} = ruta del archivo)" Style="{StaticResource caption}"/>
                                    <TextBox Text="{Binding Argumentos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}"/>
                                    <TextBlock Text="Carpeta de datos (user en Eden/Citron, portable en Ryujinx): aquí se guardan los trucos" Style="{StaticResource caption}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Examinar…" Style="{StaticResource BotonPlano}" Margin="10,4,0,10" Click="AlExaminarDatos"/>
                                        <TextBox Text="{Binding CarpetaDatos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Carpetas de juegos" Style="{StaticResource title}" Margin="0,28,0,12"/>
                <ListBox x:Name="ListaCarpetas" Style="{StaticResource Lista}" MinHeight="90" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="Agregar carpeta…" Style="{StaticResource BotonPlano}" Click="AlAgregarCarpeta"/>
                    <Button Content="Quitar la seleccionada" Style="{StaticResource BotonPlano}" Click="AlQuitarCarpeta"/>
                    <Button Content="Usar las de Eden y Ryujinx" Style="{StaticResource BotonPlano}" Click="AlDetectarCarpetas"/>
                </WrapPanel>

                <TextBlock Text="Internet" Style="{StaticResource title}" Margin="0,28,0,12"/>
                <CheckBox x:Name="CasillaContenidoEnLinea" Content="Descargar carátulas, fondos, trucos y listas de compatibilidad" Style="{StaticResource Casilla}"/>
                <TextBlock Style="{StaticResource caption}" TextWrapping="Wrap" TextTrimming="None"
                           Text="Envía el identificador (Title ID) de tus juegos a tinfoil.media, tinfoil.io y GitHub. Desactivado, se usa solo lo que ya se descargó. Las actualizaciones de emuladores se buscan aparte, en la sección Emuladores."/>
                <WrapPanel>
                    <Button Content="Leer la política de privacidad" Style="{StaticResource BotonPlano}" Click="AlLeerPrivacidad"/>
                </WrapPanel>

                <TextBlock Text="Traducción de trucos con IA" Style="{StaticResource title}" Margin="0,28,0,12"/>
                <TextBlock Style="{StaticResource caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"
                           Text="Traducir envía el nombre del juego y los de sus trucos (nunca su código) a Anthropic (Claude Code) u OpenAI (Codex), con tu cuenta."/>
                <TextBlock Text="Motor" Style="{StaticResource caption}"/>
                <ComboBox x:Name="ComboMotor" Style="{StaticResource Selector}" Margin="0,4,0,10" Width="360" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Ninguno (no traducir)" Tag="ninguno"/>
                    <ComboBoxItem Content="Claude Code" Tag="claude"/>
                    <ComboBoxItem Content="Codex" Tag="codex"/>
                </ComboBox>
                <TextBlock Text="Modelo (vacío = el predeterminado del CLI; para Claude, p. ej. haiku o sonnet)" Style="{StaticResource caption}"/>
                <TextBox x:Name="CampoModelo" Style="{StaticResource Campo}" Width="360" HorizontalAlignment="Left"/>
                <WrapPanel>
                    <Button x:Name="BotonProbar" Content="Probar traducción" Style="{StaticResource BotonPlano}" Click="AlProbarIA"/>
                </WrapPanel>
                <TextBlock x:Name="TextoPrueba" Style="{StaticResource caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"/>

                <TextBlock Text="Actualizaciones de emuladores" Style="{StaticResource title}" Margin="0,28,0,12"/>
                <TextBlock Text="Canal de Eden" Style="{StaticResource caption}"/>
                <ComboBox x:Name="ComboCanalEden" Style="{StaticResource Selector}" Margin="0,4,0,10" Width="460" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Nightly (PGO, se publica casi a diario)" Tag="nightly"/>
                    <ComboBoxItem Content="Estable (PGO)" Tag="estable"/>
                </ComboBox>
                <TextBlock Text="Variante de Citron Neo" Style="{StaticResource caption}"/>
                <ComboBox x:Name="ComboVarianteCitron" Style="{StaticResource Selector}" Margin="0,4,0,10" Width="460" HorizontalAlignment="Left">
                    <ComboBoxItem Content="x64 clang-cl (compilación nativa MSVC)" Tag="clang-cl"/>
                    <ComboBoxItem Content="x64 clangtron" Tag="clangtron"/>
                </ComboBox>
                <TextBlock Text="Las actualizaciones se hacen en la sección Emuladores (LB / RB desde Inicio)." Style="{StaticResource caption}" Margin="0,0,0,10"/>

                <TextBlock Text="Sonido y movimiento" Style="{StaticResource title}" Margin="0,28,0,12"/>
                <CheckBox x:Name="CasillaSonidos" Content="Sonidos al moverte, elegir y abrir un juego" Style="{StaticResource Casilla}"/>
                <TextBlock Text="Volumen (← → para cambiarlo; suena al elegirlo)" Style="{StaticResource caption}"/>
                <ComboBox x:Name="ComboVolumen" Style="{StaticResource Selector}" Margin="0,4,0,10" Width="360" HorizontalAlignment="Left"
                          SelectionChanged="AlCambiarVolumen"/>
                <TextBlock Text="Ventana de trucos durante el juego: tecla para mostrarla u ocultarla" Style="{StaticResource caption}"/>
                <ComboBox x:Name="ComboTeclaTrucos" Style="{StaticResource Selector}" Margin="0,4,0,10" Width="360" HorizontalAlignment="Left"/>
                <CheckBox x:Name="CasillaIntro" Content="Intro «Switch» al abrir el lanzador (se salta con cualquier botón)" Style="{StaticResource Casilla}"/>
                <CheckBox x:Name="CasillaReducirMovimiento" Content="Reducir movimiento: sin animaciones (del todo al reiniciar el lanzador)" Style="{StaticResource Casilla}"/>

                <TextBlock Text="Pantalla" Style="{StaticResource title}" Margin="0,28,0,12"/>
                <CheckBox x:Name="CasillaPantallaCompleta" Content="Iniciar en pantalla completa (F11 la alterna)" Style="{StaticResource Casilla}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,16">
            <Button x:Name="BotonGuardar" Content="Guardar" Style="{StaticResource BotonPlano}" Background="{StaticResource accent-500}"
                    Foreground="{StaticResource on-accent}" FontWeight="SemiBold" MinWidth="160" Click="AlGuardar"/>
            <Button Content="Cancelar" Style="{StaticResource BotonPlano}" MinWidth="160" Click="AlCancelar"/>
        </StackPanel>
    </Grid>
</UserControl>
