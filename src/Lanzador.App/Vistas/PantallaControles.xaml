<UserControl x:Class="Lanzador.App.Vistas.PantallaControles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid Margin="64,104,64,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="Elige el mando de cada jugador aquí mismo. Al aplicar (X), el lanzador escribe la configuración en Eden, Citron, Suyu y Ryujinx, con la asignación de botones que pondría cada emulador y un respaldo de lo anterior."/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Chip}" Margin="0,10,0,0" HorizontalAlignment="Left" Background="{StaticResource accent-soft}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource focus}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="TextoConectados" Style="{StaticResource chip}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="Desplazador" Grid.Row="2" Margin="-24,0,-24,0" Padding="24,14,24,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <ItemsControl x:Name="ListaJugadores" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Fila" CornerRadius="{StaticResource radius-md}" Padding="21,7" Margin="0,0,0,8" Background="{StaticResource surface-100}"
                                    BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonUp="AlPulsarJugador" MinHeight="58">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource body-l}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlechaIzq" Text="‹" FontSize="28" Foreground="{StaticResource ink-200}" Margin="0,0,12,4" Opacity="0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Mando" Text="{Binding TextoMando}" Style="{StaticResource body-l}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FlechaDer" Text="›" FontSize="28" Foreground="{StaticResource ink-200}" Margin="12,0,0,4" Opacity="0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Conexion" Text="{Binding TextoConexion}" Style="{StaticResource caption}" Margin="16,2,0,0" VerticalAlignment="Center"/>
                                        <Border x:Name="ChipCompartido" Style="{StaticResource Chip}" Background="{StaticResource accent-soft}" Margin="14,0,0,0"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Compartido}" Style="{StaticResource chip}" FontSize="15"/>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="ChipTipo" Grid.Column="2" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TextoTipo}" Style="{StaticResource chip}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding TieneMando}" Value="False">
                                    <Setter TargetName="Mando" Property="Foreground" Value="{StaticResource ink-300}"/>
                                    <Setter TargetName="ChipTipo" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TieneCompartido}" Value="True">
                                    <Setter TargetName="ChipCompartido" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TextoConexion}" Value="apagado">
                                    <Setter TargetName="Conexion" Property="Foreground" Value="{StaticResource warn-500}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                    <Setter TargetName="Fila" Property="Background" Value="{StaticResource surface-200}"/>
                                    <Setter TargetName="Fila" Property="BorderBrush" Value="{StaticResource focus}"/>
                                    <Setter TargetName="Fila" Property="Effect" Value="{StaticResource shadow-focus}"/>
                                    <Setter TargetName="FlechaIzq" Property="Opacity" Value="1"/>
                                    <Setter TargetName="FlechaDer" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Cómo está cada emulador frente a lo elegido -->
            <StackPanel Grid.Row="3" Margin="0,8,0,18">
                <TextBlock Text="EN LOS EMULADORES" Style="{StaticResource label}"/>
                <ItemsControl x:Name="ListaEstados" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Chip" Style="{StaticResource Chip}" Margin="0,0,8,8" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Punto" Width="10" Height="10" Fill="{StaticResource ink-300}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="{Binding Texto}" Style="{StaticResource chip}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Nivel}" Value="ok">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource ok-soft}"/>
                                    <Setter TargetName="Punto" Property="Fill" Value="{StaticResource ok-500}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Nivel}" Value="aviso">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource warn-soft}"/>
                                    <Setter TargetName="Punto" Property="Fill" Value="{StaticResource warn-500}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Nivel}" Value="error">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource danger-soft}"/>
                                    <Setter TargetName="Punto" Property="Fill" Value="{StaticResource danger-500}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Detección: "pulsa un botón en el mando de este jugador" -->
        <Grid x:Name="CapaDeteccion" Visibility="Collapsed">
            <Rectangle Fill="{StaticResource scrim-dialog}"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,36" CornerRadius="{StaticResource radius-xl}"
                    Background="{StaticResource surface-200}" Effect="{StaticResource shadow-dialog}">
                <StackPanel>
                    <TextBlock x:Name="TextoDeteccion" Style="{StaticResource title}" FontSize="34" LineHeight="40" TextAlignment="Center"/>
                    <TextBlock x:Name="TextoCuenta" Style="{StaticResource body}" Margin="0,12,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
