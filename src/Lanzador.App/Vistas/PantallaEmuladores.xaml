<UserControl x:Class="Lanzador.App.Vistas.PantallaEmuladores"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tema="clr-namespace:Lanzador.App.Tema">
    <UserControl.Resources>
        <!-- Barra de progreso: 10 px, radius-sm, surface-300 con relleno accent-500 -->
        <Style x:Key="Barra" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="{StaticResource radius-sm}" Background="{StaticResource surface-300}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="{StaticResource radius-sm}" Background="{StaticResource accent-500}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="DosColumnas">
            <UniformGrid Columns="2"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="64,104,64,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,4,0,0">
            <TextBlock Style="{StaticResource caption}" TextWrapping="Wrap" TextTrimming="None"
                       Text="Solo se reemplazan los archivos del emulador, con respaldo para volver atrás. Tus carpetas user y portable (partidas, claves, trucos y configuración) nunca se tocan."/>
        </StackPanel>

        <ScrollViewer x:Name="Desplazador" Grid.Row="1" Margin="-24,0,-24,0" Padding="24,20,24,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl x:Name="ListaEmuladores" Focusable="False" Margin="-12,0,-12,40" VerticalAlignment="Top" ItemsPanel="{StaticResource DosColumnas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- StatusCard -->
                        <Grid Margin="12,0,12,24" Cursor="Hand" MouseLeftButtonUp="AlPulsarEmulador">
                            <Border x:Name="Brillo" CornerRadius="{StaticResource radius-lg}" Background="{StaticResource surface-200}"
                                    Effect="{StaticResource shadow-focus}" Visibility="Collapsed"/>
                            <Border x:Name="Tarjeta" CornerRadius="{StaticResource radius-lg}" Padding="25,21" Background="{StaticResource surface-100}"
                                    BorderThickness="3" BorderBrush="Transparent">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- Qué hace A en la tarjeta elegida -->
                                        <Border x:Name="Accion" DockPanel.Dock="Right" Padding="8,6,18,6" Background="{StaticResource accent-500}"
                                                tema:Forma.Pastilla="True" Visibility="Collapsed" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentPresenter Content="A" ContentTemplate="{StaticResource PlantillaGlifo}"/>
                                                <TextBlock Text="{Binding TextoAccion}" FontFamily="{StaticResource font-text}" FontWeight="SemiBold" FontSize="20"
                                                           Foreground="{StaticResource on-accent}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Border x:Name="SinIcono" CornerRadius="{StaticResource radius-md}" Background="{StaticResource surface-300}" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding Inicial}" FontFamily="{StaticResource font-display}" FontWeight="SemiBold" FontSize="24"
                                                               Foreground="{StaticResource ink-300}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding Icono}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Nombre}" Style="{StaticResource title}" FontSize="30" LineHeight="36" VerticalAlignment="Center"/>
                                            <Border x:Name="ChipEstado" Style="{StaticResource Chip}" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="PuntoEstado" Width="10" Height="10" Fill="{StaticResource ink-300}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                    <TextBlock Text="{Binding TextoEstado}" Style="{StaticResource chip}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding TextoFuente}" Style="{StaticResource caption}" Margin="0,8,0,0"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="INSTALADA" Style="{StaticResource label}"/>
                                            <TextBlock Text="{Binding TextoInstalada}" Style="{StaticResource body-l}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TextoDisponibleCompleto}" Style="{StaticResource caption}" TextWrapping="Wrap" MaxHeight="44"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="RESPALDO" Style="{StaticResource label}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse x:Name="PuntoRespaldo" Width="10" Height="10" Fill="{StaticResource ink-300}" VerticalAlignment="Center" Margin="0,2,10,0"/>
                                                <TextBlock Text="{Binding TextoRespaldo}" Style="{StaticResource body-l}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DetalleRespaldo}" Style="{StaticResource caption}" TextWrapping="Wrap" MaxHeight="44"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="PanelProgreso" Margin="0,14,0,0" Visibility="Collapsed">
                                        <ProgressBar Style="{StaticResource Barra}" Value="{Binding Progreso, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding TextoProgreso}" Style="{StaticResource caption}" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TextoResultado" Text="{Binding Resultado}" Style="{StaticResource body}" Margin="0,12,0,0"
                                               TextWrapping="Wrap" TextTrimming="None" Foreground="{StaticResource ok-500}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding SinIcono}" Value="True">
                                <Setter TargetName="SinIcono" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NivelEstado}" Value="ok">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource ok-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource ok-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NivelEstado}" Value="nuevo">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource accent-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource focus}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NivelEstado}" Value="aviso">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource warn-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource warn-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NivelEstado}" Value="error">
                                <Setter TargetName="ChipEstado" Property="Background" Value="{StaticResource danger-soft}"/>
                                <Setter TargetName="PuntoEstado" Property="Fill" Value="{StaticResource danger-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NivelRespaldo}" Value="ok">
                                <Setter TargetName="PuntoRespaldo" Property="Fill" Value="{StaticResource ok-500}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Ocupado}" Value="True">
                                <Setter TargetName="PanelProgreso" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TieneResultado}" Value="True">
                                <Setter TargetName="TextoResultado" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultadoError}" Value="True">
                                <Setter TargetName="TextoResultado" Property="Foreground" Value="{StaticResource danger-500}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Seleccionado}" Value="True"/>
                                    <Condition Binding="{Binding TieneAccion}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Accion" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                <Setter TargetName="Brillo" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Tarjeta" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource focus}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
