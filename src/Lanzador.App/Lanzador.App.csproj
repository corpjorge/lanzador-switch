<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lanzador.Core\Lanzador.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL3 (licencia zlib), la misma versión que trae Ryujinx: detecta mandos y lee los que no son XInput. -->
    <None Include="nativo\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fuentes del Design System (SIL OFL 1.1): van dentro del ejecutable; sus licencias, junto a él. -->
    <Resource Include="Fuentes\*.ttf" />
    <!-- Icono propio: se genera con herramientas\GeneradorIcono -->
    <Resource Include="Icono\Lanzador.ico" />
    <None Include="Fuentes\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lanzador</AssemblyName>
    <RootNamespace>Lanzador.App</RootNamespace>
    <Product>Lanzador Switch</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 corpjorge · MIT</Copyright>
    <ApplicationIcon>Icono\Lanzador.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
